# ==============================================================================
# A Brighter Tomorrow — Environment Configuration Template
# Copy this file to .env and fill in your real credentials locally.
# NEVER commit .env or paste real keys into code, logs, or notebooks.
# ==============================================================================

# --- Safety Guard ---
# Keep false until you explicitly approve making live external API calls.
ALLOW_PAID_API=false

# --- Google Gemini API (Script polish + English Narration TTS) ---
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon

# --- Cloudflare Workers AI (FLUX Keyframes & Reference Sheet) ---
# 1) CLOUDFLARE_ACCOUNT_ID: Log into https://dash.cloudflare.com -> Account Home or
#    Workers & Pages -> copy the 32-character Account ID from the right sidebar (or URL).
# 2) CLOUDFLARE_API_TOKEN: My Profile -> API Tokens -> Create Token ->
#    use the "Workers AI" template (Account -> Workers AI -> Read & Edit).
# 3) CLOUDFLARE_TOKEN_TYPE: 'user' (My Profile -> API Tokens) or 'account' (Manage Account -> Account API Tokens).
CLOUDFLARE_ACCOUNT_ID=your_32_char_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
CLOUDFLARE_TOKEN_TYPE=user
IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
IMAGE_FALLBACK_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Hugging Face (For downloading open-weight video & music models in Colab/Kaggle) ---
# Create read token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_read_token_here

# --- Pipeline Provider Selection ---
# image_provider: external_local | offline_local | cloudflare_flux
IMAGE_PROVIDER=external_local
# narration_provider: placeholder | local_tts | gemini_tts
NARRATION_PROVIDER=local_tts
# video_provider: ken_burns | wan22 | hunyuan15
VIDEO_PROVIDER=ken_burns
# music_provider: placeholder_temp | local_score | ace_step_15
MUSIC_PROVIDER=local_score

# --- Tooling Paths ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
