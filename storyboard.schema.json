{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/a-brighter-tomorrow/storyboard.schema.json",
  "title": "A Brighter Tomorrow Storyboard Schema",
  "description": "Single-source-of-truth contract for all stages of the 60-90 second short film pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "music", "shots", "end_card"],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "narration_language",
        "visual_style",
        "target_total_duration_sec",
        "aspect_ratios",
        "style_block",
        "character"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "narration_language": { "type": "string", "minLength": 2 },
        "visual_style": { "type": "string", "minLength": 5 },
        "target_total_duration_sec": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        },
        "aspect_ratios": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["16:9", "9:16"] }
        },
        "style_block": { "type": "string", "minLength": 10 },
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_fictional", "identity_anchor", "stages"],
          "properties": {
            "is_fictional": { "type": "boolean", "const": true },
            "identity_anchor": { "type": "string", "minLength": 10 },
            "stages": {
              "type": "object",
              "additionalProperties": false,
              "required": ["childhood", "adolescence", "young_adulthood"],
              "properties": {
                "childhood": { "type": "string", "minLength": 10 },
                "adolescence": { "type": "string", "minLength": 10 },
                "young_adulthood": { "type": "string", "minLength": 10 }
              }
            }
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "tempo_bpm", "key", "instrumental", "target_duration_sec"],
      "properties": {
        "caption": { "type": "string", "minLength": 10 },
        "tempo_bpm": { "type": "integer", "minimum": 40, "maximum": 180 },
        "key": { "type": "string", "minLength": 2 },
        "instrumental": { "type": "boolean", "const": true },
        "target_duration_sec": { "type": "number", "minimum": 15, "maximum": 120 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "scene_title",
          "age_stage",
          "reason",
          "duration_sec",
          "shot_type",
          "lighting",
          "transition",
          "image_prompt",
          "motion_prompt",
          "narration",
          "music_cue",
          "seed"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "scene_title": { "type": "string", "minLength": 2 },
          "age_stage": {
            "type": "string",
            "enum": ["none", "childhood", "adolescence", "young_adulthood"]
          },
          "reason": { "type": "string", "minLength": 10 },
          "duration_sec": {
            "type": "number",
            "minimum": 4.0,
            "maximum": 15.0
          },
          "shot_type": { "type": "string", "minLength": 3 },
          "lighting": { "type": "string", "minLength": 5 },
          "transition": {
            "type": "string",
            "enum": ["cut", "crossfade", "fade_from_black", "fade_to_black"]
          },
          "image_prompt": { "type": "string", "minLength": 15 },
          "motion_prompt": { "type": "string", "minLength": 10 },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "language", "draft_status"],
            "properties": {
              "text": { "type": "string", "minLength": 5 },
              "language": { "type": "string", "minLength": 2 },
              "draft_status": {
                "type": "string",
                "enum": [
                  "draft_awaiting_radio_cut_review",
                  "approved_for_tts",
                  "locked"
                ]
              },
              "style_instruction": { "type": "string" }
            }
          },
          "music_cue": { "type": "string", "minLength": 5 },
          "seed": { "type": "integer", "minimum": 0 },
          "cultural_notes": { "type": "string" }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "duration_sec", "title", "subtitle", "ai_disclosure_text"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "duration_sec": {
          "type": "number",
          "minimum": 2.0,
          "maximum": 5.0
        },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "ai_disclosure_text": { "type": "string", "minLength": 10 }
      }
    }
  }
}
